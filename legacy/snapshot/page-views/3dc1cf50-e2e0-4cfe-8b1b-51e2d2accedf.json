let":{"fontSize":"24px"},"color":"var(--s-color-9a938a70)","fontFamily":"var(--s-font-3c90ade0)","fontSize":"32px","fontStyle":"normal","fontWeight":"400","height":"auto","letterSpacing":"0em","lineHeight":"1.6","textAlign":"left","width":"auto"},"tagName":"h3","uuid":"8962357f-081e-4b9d-9e78-9ab0f4963bfe","children":[]},{"content":{"data":"日本で企業経営を行う中で、真の課題は「違いを正しく理解すること」にあると私たちは考えています。言語・文化・ビジネス習慣の違いは、気づかないうちに誤解やすれ違いを生み、事業運営上のリスクにつながることがあります。しかし、正しい知識と適切な方法があれば、こうしたリスクを事前に防ぎ、より安定した経営基盤を築くことができます。HAJIMEコンサルティング株式会社は、実務に即したコンサルティングや研修、専門家との連携を通じて、日本で事業を行う企業の安定的かつ持続可能な成長をサポートいたします。単なる相談先ではなく、長期的なパートナーとして。お客様とともに考え、ともに歩み、ともに成長してまいります。","type":"text"},"name":"テキスト","style":{"@tablet":{"fontSize":"15px"},"color":"var(--s-color-9a938a70)","fontFamily":"var(--s-font-3c90ade0)","fontSize":"16px","fontStyle":"normal","fontWeight":"400","height":"auto","letterSpacing":"0em","lineHeight":"1.9","padding":"0px 0px 0px 0px","textAlign":"left","textDecoration":"none","width":"100%"},"uuid":"c1dec17d-cc84-4c5f-ab7b-767cae66c73a","children":[]},{"children":[{"content":{"data":"HAJIMEコンサルティング株式会社<br>代表取締役","type":"text"},"name":"肩書き","style":{"@tablet":{"fontSize":"15px"},"color":"var(--s-color-9a938a70)","fontFamily":"var(--s-font-3c90ade0)","fontSize":"14px","fontStyle":"normal","fontWeight":"400","height":"auto","letterSpacing":"0em","lineHeight":"1.6","textAlign":"right","width":"100%"},"uuid":"599dbbe4-705b-404b-8d10-8e060989437c","children":[]},{"content":{"data":"牧野 奈々美(MAKINO NANAMI)","type":"text"},"name":"名前","style":{"@tablet":{"fontSize":"18px"},"color":"var(--s-color-9a938a70)","fontFamily":"var(--s-font-3c90ade0)","fontSize":"18px","fontStyle":"normal","fontWeight":"400","height":"auto","letterSpacing":"0em","lineHeight":"1.6","textAlign":"right","width":"100%"},"uuid":"fe31ec2e-4438-43d0-893d-d3519021ae59","children":[]}],"name":"署名","style":{"@mobile":{"padding":"0px"},"alignContent":"flex-end","alignItems":"flex-end","flexDirection":"column","flexWrap":"nowrap","gap":"0px","height":"auto","justifyContent":"flex-start","padding":"0px","width":"100%"},"uuid":"ce700bf5-dcb1-4248-b0c2-0bba03d34ce6"},{"type":"ref","refId":"f120c1fc-2201-4de7-8ca0-835d2103a912","state":{"text1":"PROFILE","text2":"日中両国における学習および実務経験を有し、長年にわたりクロスカルチャー分野でのビジネス支援に従事。 経営学を専攻し、日本の大手広告会社にて勤務後、企業の実務運営にも携わる。これまでの豊富な実務経験を通じて、日本で事業を展開する外国人経営者が直面する情報格差および認識の違いに対する深い理解を有する。現在は、在日外国人経営者に対し、より実践的かつ有効性の高い支援・サービスの提供に注力している。"}}],"name":"テキストエリア","style":{"@mobile":{"padding":"0px"},"@small":{"flex":"none","width":"50%"},"@tablet":{"flex":"none","gap":"20px","margin":"40px 0px 0px 0px","width":"480px"},"alignContent":"center","alignItems":"center","flex":"none","flexDirection":"column","flexWrap":"nowrap","gap":"28px","height":"auto","justifyContent":"center","padding":"0px","width":"49%"},"tagName":"","uuid":"cf84ae9f-c67b-41ec-b207-c7c54e2088d8"}],"name":"コンテンツ","style":{"@tablet":{"alignContent":"center","alignItems":"center","flexDirection":"column","flexWrap":"nowrap","justifyContent":"flex-start"},"alignContent":"stretch","alignItems":"stretch","flexDirection":"row","flexWrap":"nowrap","justifyContent":"space-between","padding":"0px"},"tagName":"div","uuid":"2f025f6e-c1ae-4ef8-aa3d-a37830633daf"}],"name":"インナー","style":{"&appear":{"@mobile":{"transitionDelay":"1400ms"},"@tablet":{"transitionDelay":"1500ms"},"opacity":"0","transform":"","transitionDelay":"1400ms","transitionDuration":"800ms","transitionTimingFunction":"ease-in-out"},"@mobile":{"flex":"none","padding":"0px 0px","width":"90%"},"@small":{"flex":"none","padding":"0px 72px"},"@tablet":{"flex":"none","margin":"64px 0px 88px 0px","padding":"0px 0px","width":"90%"},"alignContent":"center","alignItems":"center","flex":"none","flexDirection":"column","flexWrap":"nowrap","justifyContent":"flex-start","margin":"100px 0px 120px 0px","padding":"0px 80px","width":"1280px"},"tagName":"div","uuid":"25efbf04-aefe-4d8d-a246-1a75f675642f"}],"id":"message","name":"代表のあいさつ","style":{"alignContent":"center","alignItems"