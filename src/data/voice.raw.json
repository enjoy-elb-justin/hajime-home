[{"document":{"name":"3ei2krBD9vnNjpJ5JUi1","fields":{"_filter":{"arrayValue":{"values":[{"stringValue":"G7rlLfms:0Evj4VCx"}]}},"_meta":{"mapValue":{"fields":{"publishType":{"stringValue":"change"},"updatedAt":{"timestampValue":"2026-06-16T12:59:40+00:00"},"order":{"integerValue":"12"},"schema":{"mapValue":{"fields":{"id":{"stringValue":"y6rodx9X8smOqX2ql9PV"},"key":{"stringValue":"posts"},"postType":{"stringValue":"post"}}}},"createdAt":{"timestampValue":"2023-11-27T10:35:59+00:00"},"publishedAt":{"timestampValue":"2023-11-25T10:36:00+00:00"},"audit":{"mapValue":{"fields":{"publishedAt":{"timestampValue":"2026-06-16T12:59:48+00:00"},"createdAt":{"timestampValue":"2023-11-27T10:35:59+00:00"},"updatedAt":{"timestampValue":"2023-11-27T10:35:59+00:00"}}}},"uid":{"stringValue":"VPjys6aF"},"project":{"mapValue":{"fields":{"id":{"stringValue":"bdec933c73ef4affaa19"}}}}}}},"default":{"mapValue":{"fields":{"drG7fqRC":{"stringValue":"C社"},"cover":{"stringValue":"/assets/storage.stock.studio.design/optimized/5slJwMMqbMxshpZoYP1d8.webp"},"body":{"stringValue":"\u003Ch2 data-uid=\"qFR1MFvY\" data-time=\"1709810802029\" id=\"index_qFR1MFvY\"\u003E先代から続いている信頼感\u003C/h2\u003E\u003Cp data-uid=\"BTD5QFwX\" data-time=\"1709810897472\"\u003Eおだやか会計事務所さんとのお付き合いは父の代からなのですが、そのころから信頼があり、地域でも評判が良いことを知っていました。事業継承の際も手厚いサポートがあり、とても心強かったです。\u003C/p\u003E\u003Cfigure data-uid=\"XNZnxJpy\" data-time=\"1701053841091\" data-thread=\"\" style=\"text-align: \"\u003E\u003Cimg src=\"/assets/storage.googleapis.com/studio-cms-assets/projects/brqEMjnwq4/s-920x608_v-fs_webp_9952437a-c6c1-4286-b8d6-a6d00848e753.jpg/" alt=\"\" width=\"\" height=\"\"\u003E\u003Cfigcaption\u003E\u003C/figcaption\u003E\u003C/figure\u003E\u003Ch2 data-uid=\"r9eqCM_b\" data-time=\"1709810958436\" id=\"index_r9eqCM_b\"\u003E会計業務だけではない、頼りになる存在です\u003C/h2\u003E\u003Cp data-uid=\"azOZzSg1\" data-time=\"1709811016556\"\u003Eおだやか会計事務所さんには、会計や税務だけでなく、ビジネスのアドバイスや相続・事業継承のサポートもしていただいています。私が事業を引き継ぐ際にも、専門的なサポートをしていただき、大変たすかりました。\u003C/p\u003E\u003Ch2 data-uid=\"f4GTRL_i\" data-time=\"1709811011871\" id=\"index_f4GTRL_i\"\u003E\u003C/h2\u003E\u003Cp data-uid=\"05SdnoLa\" data-time=\"1709811018231\"\u003E\u003C/p\u003E"},"title":{"stringValue":"専門家との連携もスムーズで安心感があります。"},"slug":{"stringValue":"C"},"yIltiILX":{"stringValue":"専門家との連携"}}}}}}},{"document":{"name":"Bv4MPm9UXmGYQPtRR1kq","fields":{"_filter":{"arrayValue":{"values":[{"stringValue":"G7rlLfms:iKGDntyA"}]}},"_meta":{"mapValue":{"fields":{"order":{"integerValue":"13"},"publishType":{"stringValue":"change"},"updatedAt":{"timestampValue":"2026-06-16T12:59:33+00:00"},"schema":{"mapValue":{"fields":{"key":{"stringValue":"posts"},"postType":{"stringValue":"post"},"id":{"stringValue":"y6rodx9X8smOqX2ql9PV"}}}},"createdAt":{"timestampValue":"2023-11-27T10:35:57+00:00"},"publishedAt":{"timestampValue":"2023-11-23T10:43:00+00:00"},"audit":{"mapValue":{"fields":{"updatedAt":{"timestampValue":"2023-11-27T10:35:57+00:00"},"createdAt":{"timestampValue":"2023-11-27T10:35:57+00:00"},"publishedAt":{"timestampValue":"2026-06-16T12:59:49+00:00"}}}},"uid":{"stringValue":"f7c0JRkN"},"project":{"mapValue":{"fields":{"id":{"stringValue":"bdec933c73ef4affaa19"}}}}}}},"default":{"mapValue":{"fields":{"title":{"stringValue":"日本のビジネスマナーを体系的に理解できました。"},"body":{"stringValue":"\u003Ch2 data-uid=\"qFR1MFvY\" data-time=\"1709811061505\" id=\"index_qFR1MFvY\"\u003E会計業務の効率化が課題でした\u003C/h2\u003E\u003Cp data-uid=\"BTD5QFwX\" data-time=\"1709811124092\"\u003E会計業務の効率化とデータの安全性を確保するためにクラウド導入をしたいと思い、おだやか会計事務所さんにお願いすることにしました。\u003C/p\u003E\u003Cp data-uid=\"Zok2uEXA\" data-time=\"1709811140931\"\u003E正直なところ、自分で行うには情報の漏洩やセキュリティの問題、システムの運用面での課題などが心配でした。\u003C/p\u003E\u003Ch2 data-uid=\"tDDq_jgq\" data-time=\"1709811176375\" id=\"index_tDDq_jgq\"\u003E専門家のサポートのおかげで、スムーズに導入完了\u003C/h2\u003E\u003Cp data-uid=\"aVnCO0RW\" data-time=\"1709811234132\"\u003E不安だったクラウド導入も、専門家のサポートのおかげでスムーズに完了しました。データの安全性も確保され、会計業務の効率化が実感できています。\u003C/p\u003E\u003Cfigure data-uid=\"XNZnxJpy\" data-time=\"1701053841091\" data-thread=\"\" style=\"text-align: \"\u003E\u003Cimg src=\"/assets/storage.googleapis.com/studio-cms-assets/projects/brqEMjnwq4/s-920x608_v-fs_webp_9952437a-c6c1-4286-b8d6-a6d00848e753.jpg/" alt=\"\" width=\"\" height=\"\"\u003E\u003Cfigcaption\u003E\u003C/figcaption\u003E\u003C/figure\u003E\u003Ch2 data-uid=\"r9eqCM_b\" data-time=\"1701079388091\" id=\"index_r9eqCM_b\"\u003E丁寧なサポートのおかげで、安心して運用できています。\u003C/h2\u003E\u003Cp data-uid=\"azOZzSg1\" data-time=\"1701079546797\"\u003E初期導入はもちろんのこと、運用後も丁寧にサポートしていただき、安心して運用することができています。\u003C/p\u003E"},"cover":{"stringValue":"/assets/storage.stock.studio.design/optimized/cyVAMN5GvaG9rrUfYrMln.webp"},"drG7fqRC":{"stringValue":"B社"},"yIltiILX":{"stringValue":"日本のビジネスマナー"},"slug":{"stringValue":"B"}}}}}}},{"document":{"name":"9Xej2zfyMCL7ObRdoAlJ","fields":{"_filter":{"arrayValue":{"values":[{"stringValue":"G7rlLfms:sOVP6q8b"},{"stringValue":"G7rlLfms:txsxCKYH"}]}},"_meta":{"mapValue":{"fields":{"schema":{"mapValue":{"fields":{"id":{"stringValue":"y6rodx9X8smOqX2ql9PV"},"key":{"stringValue":"posts"},"postType":{"stringValue":"post"}}}},"updatedAt":{"timestampValue":"2026-06-16T12:59:28+00:00"},"publishType":{"stringValue":"change"},"order":{"integerValue":"14"},"project":{"mapValue":{"fields":{"id":{"stringValue":"bdec933c73ef4affaa19"}}}},"uid":{"stringValue":"9aN_AQLP"},"audit":{"mapValue":{"fields":{"updatedAt":{"timestampValue":"2023-11-27T10:38:50+00:00"},"createdAt":{"timestampValue":"2023-11-27T10:38:50+00:00"},"publishedAt":{"timestampValue":"2026-06-16T12:59:50+00:00"}}}},"publishedAt":{"timestampValue":"2023-11-22T10:41:00+00:00"},"createdAt":{"timestampValue":"2023-11-27T10:38:50+00:00"}}}},"default":{"mapValue":{"fields":{"slug":{"stringValue":"A"},"yIltiILX":{"stringValue":"グローバルコミュニケーション"},"drG7fqRC":{"stringValue":"A社"},"cover":{"stringValue":"/assets/storage.stock.studio.design/optimized/EuIyc2lndi3TQg14Cnmad.webp"},"body":{"stringValue":"\u003Ch2 data-uid=\"qFR1MFvY\" data-time=\"1709811276443\" id=\"index_qFR1MFvY\"\u003E事業拡大を見据えたタイミングで\u003C/h2\u003E\u003Cp data-uid=\"BTD5QFwX\" data-time=\"1709811307550\"\u003E事業拡大を見据えた際に、従来の会計業務の方法では対応しきれないことが明らかになりました。効率化と正確性を求めて見直したいと思い、会計顧問をお願いすることにしました。\u003C/p\u003E\u003Cfigure data-uid=\"Dq76vWhu\" data-time=\"1701081592578\" data-thread=\"\" style=\"text-align: \"\u003E\u003Cimg src=\"/assets/storage.googleapis.com/studio-cms-assets/projects/brqEMjnwq4/s-1584x1200_v-fms_webp_7ec40d1c-5a65-400b-978f-a9ea0f37c674.jpg/" alt=\"\" width=\"\" height=\"\"\u003E\u003Cfigcaption\u003E\u003C/figcaption\u003E\u003C/figure\u003E\u003Ch2 data-uid=\"tDDq_jgq\" data-time=\"1709811337897\" id=\"index_tDDq_jgq\"\u003E社内の業務負荷削減が早くも実現\u003C/h2\u003E\u003Cp data-uid=\"aVnCO0RW\" data-time=\"1709811341395\"\u003E会計業務の見直しにより、業務の効率化と正確性が大幅に向上しました。作業時間の短縮やエラーの軽減により、社内の業務負荷が軽減されました。\u003C/p\u003E\u003Cp data-uid=\"qSlSiGyk\" data-time=\"1709811361661\"\u003Eまた精度の高い情報を迅速に得ることができるようになりました。これにより、事業拡大に向けた戦略的な意思決定が可能になりました。\u003C/p\u003E"},"title":{"stringValue":"外国人スタッフとのコミュニケーションが格段に良くなりました。"}}}}}}}]