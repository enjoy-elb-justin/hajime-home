---
import '../styles/fonts.css';
import '../styles/studio-base.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title = "HAJIMEコンサルティング株式会社｜外国人経営者向けコンサルティング",
  description = "HAJIMEコンサルティング株式会社のコーポレートサイト。日本で挑戦する外国人経営者が安心して成長するためのコンサルティングサービス。",
  ogImage = "/images/common/og-image.jpg",
  canonicalUrl
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <meta name="robots" content="all" />

  <!-- Open Graph / Facebook -->
  <meta property="og:site_name" content="HAJIMEコンサルティング株式会社｜外国人経営者向けコンサルティング" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content="website" />
  {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={ogImage} />

  <!-- Icons -->
  <link rel="icon" type="image/png" href="/images/common/favicon.png" />
  <link rel="apple-touch-icon" type="image/png" href="/images/common/favicon.png" />
  {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
  <script is:inline>
    if (location.pathname === '/') document.documentElement.classList.add('home-splash-pending');
  </script>

  <!-- Fonts & Core Stylesheets -->
  <style is:global>
    :root {
      --s-color-90ba6ad1: #1aa583ff;
      --s-color-d8b8d223: #0f876aff;
      --s-color-15956284: #ffffffff;
      --s-color-6dbe09e7: #f1eee8ff;
      --s-color-2da9f51e: #f5f5f5ff;
      --s-color-9a938a70: #292929ff;
      --s-color-2a9c7810: #666666ff;
      --s-color-7db87864: #d6d6d6ff;
      --s-color-0585a4b9: #e2e2e2ff;
      --s-font-3c90ade0: 'Open Sans','こぶりなゴシック W3 JIS2004',sans-serif;
      --s-font-25941c40: 'Open Sans','こぶりなゴシック W6 JIS2004',sans-serif;
      --s-font-3c956f42: Inter,sans-serif;
    }

    body, html {
      margin: 0;
      padding: 0;
      font-family: var(--s-font-3c90ade0);
      color: #333;
      background: #ffffff;
      -webkit-font-smoothing: antialiased;
    }

    /* Mobile drawer navigation modal */
    .mobile-nav-modal {
      display: flex;
      justify-content: flex-end;
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: rgba(0, 0, 0, 0.4);
      opacity: 0;
      transition: opacity 400ms cubic-bezier(0.4, 0.4, 0, 1);
    }
    .mobile-nav-modal[hidden] {
      display: none;
    }
    .mobile-nav-modal[data-state="open"] {
      opacity: 1;
    }
    .mobile-nav-drawer {
      width: 100%;
      max-width: 520px;
      height: 100%;
      background: #ffffff;
      overflow-y: auto;
      box-sizing: border-box;
      padding: 32px 24px 40px;
      display: flex;
      flex-direction: column;
      box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
      position: relative;
      transform: translate3d(100%, 0, 0);
      transition: transform 400ms cubic-bezier(0.4, 0.4, 0, 1);
      outline: none;
    }
    .mobile-nav-modal[data-state="open"] .mobile-nav-drawer {
      transform: translate3d(0, 0, 0);
    }
    .mobile-nav-close {
      align-self: flex-end;
      background: none;
      border: none;
      font-size: 28px;
      line-height: 1;
      cursor: pointer;
      padding: 8px;
      color: #292929;
    }
    .mobile-nav-links {
      list-style: none;
      padding: 0;
      margin: 16px 0 0;
      display: flex;
      flex-direction: column;
      gap: 0px;
    }
    .mobile-nav-links > li {
      border-bottom: 1px solid #e2e2e2;
      padding: 14px 0;
    }
    .mobile-nav-links a {
      color: #292929;
      text-decoration: none;
      font-size: 17px;
      font-weight: 400;
      display: block;
    }
    .mobile-nav-sublinks {
      list-style: none;
      padding: 10px 0 4px 16px;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .mobile-nav-sublinks a {
      font-size: 15px;
      color: #666;
    }
    .mobile-nav-contact {
      margin-top: 32px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .mobile-nav-phone {
      background: #f1eee8;
      border-radius: 10px;
      padding: 16px;
      text-align: center;
      text-decoration: none;
      color: #292929;
    }
    .mobile-nav-phone .num {
      font-weight: 700;
      font-size: 20px;
      color: #292929;
    }
    .mobile-nav-phone .hours {
      font-size: 12px;
      color: #666;
      margin-top: 4px;
    }
    .mobile-nav-btn {
      background: #1aa583;
      color: #ffffff !important;
      border-radius: 10px;
      padding: 16px;
      text-align: center;
      font-weight: 600;
      text-decoration: none;
      font-size: 16px;
    }

    [data-home-loader][data-splash-state="running"] {
      z-index: 9998 !important;
      pointer-events: none;
    }
    [data-home-loader][hidden] {
      display: none !important;
    }
    html.home-splash-pending [data-s-781552d3-2b09-48aa-8fa4-d3c79fa027fd] {
      opacity: 1;
      z-index: 9998;
    }
    html.home-splash-pending [data-s-fc4fdcb9-b360-481b-af55-a37f302dadf0] {
      opacity: 0;
    }
    html.home-splash-active,
    html.home-splash-active body {
      overflow: hidden;
    }

    #overview {
      scroll-margin-top: 96px;
    }

    .faq-list-link {
      color: inherit;
      display: contents;
      text-decoration: none;
    }
    .faq-list-link:focus-visible > .sd {
      outline: 2px solid var(--s-color-90ba6ad1);
      outline-offset: 4px;
    }

    @media (prefers-reduced-motion: reduce) {
      .mobile-nav-modal,
      .mobile-nav-drawer {
        transition-duration: 0.01ms !important;
      }
    }
  </style>
  <noscript>
    <style>
      [data-home-loader], [data-s-781552d3-2b09-48aa-8fa4-d3c79fa027fd] { display: none !important; }
      [data-home-content], [data-s-fc4fdcb9-b360-481b-af55-a37f302dadf0], .appear {
        opacity: 1 !important;
        translate: none !important;
        scale: 1 !important;
        transform: none !important;
      }
      [id^="studio-toggle-content-"] {
        display: flex !important;
        height: auto !important;
        max-height: none !important;
        opacity: 1 !important;
        overflow: visible !important;
        visibility: visible !important;
      }
    </style>
  </noscript>
  <slot name="head" />
</head>
<body>
  <div id="__site-root">
    <slot />
  </div>

  <!-- Mobile Drawer Modal -->
  <div id="mobile-drawer" class="mobile-nav-modal" role="dialog" aria-modal="true" aria-label="モバイルメニュー" data-state="closed" hidden>
    <div class="mobile-nav-drawer" tabindex="-1">
      <button id="mobile-drawer-close" class="mobile-nav-close" type="button" aria-label="メニューを閉じる">✕</button>
      <ul class="mobile-nav-links">
        <li><a href="/">トップページ</a></li>
        <li>
          <a href="/service">業務分野</a>
          <ul class="mobile-nav-sublinks">
            <li><a href="/service/startup">・ 在日経営コンサルティング支援</a></li>
            <li><a href="/service/accounting">・ 組織運営・コミュニケーション支援</a></li>
            <li><a href="/service/inheritance">・ 専門家連携サポート</a></li>
          </ul>
        </li>
        <li>
          <a href="/company">事務所について</a>
          <ul class="mobile-nav-sublinks">
            <li><a href="/company#message">・ 代表のあいさつ</a></li>
            <li><a href="/company#philosophy">・ 経営理念</a></li>
            <li><a href="/company#team">・ スタッフ紹介</a></li>
            <li><a href="/company#overview">・ 事務所概要・アクセス</a></li>
          </ul>
        </li>
        <li><a href="/#voice">お客様の声</a></li>
        <li><a href="/news">お知らせ</a></li>
        <li><a href="/faq">よくあるご質問</a></li>
      </ul>
      <div class="mobile-nav-contact">
        <a href="tel:06-7172-3752" class="mobile-nav-phone">
          <div class="num">📞 06-7172-3752</div>
          <div class="hours">平日 9:00〜18:00</div>
        </a>
        <a href="/contact" class="mobile-nav-btn">お問い合わせフォーム →</a>
      </div>
    </div>
  </div>

  <script>
    import { initAccordions } from '../scripts/accordion';
    import { initAppear } from '../scripts/appear';
    import { initCarousels } from '../scripts/carousel';
    import { initContentFixes } from '../scripts/content-fixes';
    import { initHomeSplash } from '../scripts/home-splash';
    import { initMobileNav } from '../scripts/mobile-nav';

    const initializeInteractions = () => {
      initHomeSplash();
      initAccordions();
      initCarousels();
      initContentFixes();
      initMobileNav();
      initAppear();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeInteractions, { once: true });
    } else {
      initializeInteractions();
    }
  </script>
</body>
</html>
