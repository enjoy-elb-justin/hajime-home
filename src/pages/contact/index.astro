---
import Layout from '../../layouts/Layout.astro';

const title = "HAJIMEコンサルティング株式会社｜外国人経営者向けコンサルティング";
const description = "HAJIMEコンサルティング株式会社のコーポレートサイト。日本で挑戦する外国人経営者が安心して成長するためのコンサルティングサービス。";
const ogImage = "/images/common/og-image.jpg";

import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title={title} description={description} ogImage={ogImage}>
<style is:global>
  .contact-form-status {
    width: 100%;
    margin: -8px 0 0;
    color: #b42318;
    font-size: 14px;
    line-height: 1.6;
    text-align: center;
  }
  .contact-environment-note {
    width: 100%;
    margin: -4px 0 0;
    color: #666666;
    font-size: 12px;
    line-height: 1.7;
    text-align: left;
  }
  form[data-contact-form][aria-busy="true"] button[type="submit"] {
    cursor: wait;
    opacity: 0.6;
  }
</style>
