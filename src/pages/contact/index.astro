<script>
  const form = document.querySelector<HTMLFormElement>('form[data-contact-form]');
  const status = document.getElementById('contact-form-status');

  if (form && !document.getElementById('contact-environment-note')) {
    const environmentNote = document.createElement('p');
    environmentNote.id = 'contact-environment-note';
    environmentNote.className = 'contact-environment-note';
    environmentNote.textContent = '送信時に、受付日時、ブラウザ・OS、言語、タイムゾーン、画面サイズ、およびCloudflareによる概算地域情報を、お問い合わせ対応と不具合調査のため取得します。IPアドレスや正確な位置情報はメールに記載しません。';
    form.insertBefore(environmentNote, form.querySelector('button[type="submit"]'));
  }

  interface NavigatorWithUserAgentData extends Navigator {
    userAgentData?: {
      mobile?: boolean;
      platform?: string;
    };
  }

  const buildContactPayload = (contactForm: HTMLFormElement): FormData => {
    const payload = new FormData(contactForm);
    const navigatorData = navigator as NavigatorWithUserAgentData;
    let timezone = '';

    try {
      timezone = Intl.DateTimeFormat().resolvedOptions().timeZone ?? '';
    } catch {
      // The server can fall back to Cloudflare's coarse request timezone.
    }

    payload.set('_client_language', navigator.language ?? '');
    payload.set('_client_timezone', timezone);
    payload.set('_client_viewport', `${window.innerWidth} × ${window.innerHeight}`);
    payload.set(
      '_client_screen',
      `${window.screen.width} × ${window.screen.height} @ ${window.devicePixelRatio || 1}x`,
    );
    payload.set('_client_platform', navigatorData.userAgentData?.platform ?? '');
    payload.set(
      '_client_mobile',
      typeof navigatorData.userAgentData?.mobile === 'boolean'
        ? String(navigatorData.userAgentData.mobile)
        : '',
    );

    return payload;
  };

  form?.addEventListener('submit', async (event) => {
    if (!form.checkValidity()) {
      event.preventDefault();
      form.reportValidity();
      return;
    }

    event.preventDefault();
    if (form.getAttribute('aria-busy') === 'true') return;

    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    form.setAttribute('aria-busy', 'true');
    if (submitButton) submitButton.disabled = true;
    if (status) {
      status.hidden = false;
      status.textContent = '送信しています…';
      status.style.color = '#666666';
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: buildContactPayload(form),
      });
      let result: unknown = null;
      try {
        result = await response.json();
      } catch {
        // A proxy may replace the JSON error response with HTML.
      }
      const message =
        typeof result === 'object' && result !== null &&
        typeof Reflect.get(result, 'message') === 'string'
          ? String(Reflect.get(result, 'message'))
          : '送信できませんでした。時間をおいてもう一度お試しください。';

      if (!response.ok) throw new Error(message);

      const redirect =
        typeof result === 'object' && result !== null &&
        typeof Reflect.get(result, 'redirect') === 'string'
          ? String(Reflect.get(result, 'redirect'))
          : '/contact/thanks';
      window.location.assign(redirect);
    } catch (error) {
      if (status) {
        status.hidden = false;
        status.textContent = error instanceof Error
          ? error.message
          : '送信できませんでした。時間をおいてもう一度お試しください。';
        status.style.color = '#b42318';
        status.focus();
      }
      form.removeAttribute('aria-busy');
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>
